<div class="mx-auto md:w-2/3 w-full">
  <%% if alert = flash[:alert] %>
    <p class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-lg inline-block"><%%= alert %></p>
  <%% end %>

  <%% if notice = flash[:notice] %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block"><%%= notice %></p>
  <%% end %>

  <h1 class="font-bold text-4xl">Two-factor authentication</h1>
  <p class="mt-2 text-gray-600">Use a security key to sign in.</p>

  <%%= form_with(
    scope: :session,
    url: second_factor_authentication_path,
    method: :post,
    class: "contents",
    data: {
      controller: "webauthn-credentials",
      action: "webauthn-credentials#get:prevent",
      "webauthn-credentials-options-url-value": get_options_second_factor_authentication_path,
    }) do |f| %>
    <%%= f.hidden_field :public_key_credential, data: { "webauthn-credentials-target": "credentialHiddenInput" } %>
    <div class="my-5">
      <%%= f.submit "Use Security Key", disabled: true, data: { "webauthn-credentials-target": "submitButton" }, class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer disabled:bg-gray-400 disabled:cursor-not-allowed" %>
    </div>
  <%% end %>
</div>
